# ---- OS ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---- 编辑器 ----
.vscode/
.idea/
*.swp
*.swo

# ---- Node（如后续加构建脚本） ----
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-lock.yaml

# ---- Python（如 Skill 附带脚本） ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- 本机运行时（每台机器自己生成，不入库） ----
# 墨刀直连凭证：access_token / refresh_token / 注册的 client_id 全在这里
skills/modao-prototype/modao/state.json
skills/*/state.json
skills/*/*/state.json
# 授权时写出的待打开链接（含 state 与 code_challenge）
skills/modao-prototype/modao/open-url.txt
skills/*/*/open-url.txt
# 抓取缓存、导出目录
skills/*/cache/
skills/*/out/
skills/*/*/cache/
skills/*/*/out/
# 语雀 Token（只读但等于账号读权限）
skills/yuque-docs/yuque/state.json
skills/yuque-docs/yuque/*.token.json

# ---- 本项目产物 ----
# 生成的 HTML 交付物默认不入库；确需留存时用 git add -f 显式添加
output/
*.local.html
# 墨刀「导出原型为 HTML」的大文件：随源文件反复重导，不入库，重新导出即可
# （用户提供的、要长期留存的示例原型放在 templates/samples/，那条路径不受此规则影响）
*.export.html
*.temp.html
templates/**/*-副本.*
templates/**/*~*

# 工具临时/诊断目录
.acl-report/
.tmp/
tmp/

# ---- 密钥扫描兜底：任何命名的 .env 与密钥文件都不入库 ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
secrets/
credentials/

# ---- 语雀拉取的临时素材（PRD 全文快照 + CDN 图片），不入库 ----
_tmp_prd_full.md
_tmp_imgs/
# ---- 第8章解析中间产物与图片预览（不入库）----
_tmp_ch8.json
_tmp_parse8.js
_tmp_peek/
# ---- 临时文件（不入库）----
_preview_template.html
_tmp_dbg.js
_tmp_demo_build.js
_tmp_demo_data.json
_tmp_demo_img.txt